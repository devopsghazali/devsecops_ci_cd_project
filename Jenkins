
pipeline {
  agent any

  tools {
    maven 'maven-3'
    jdk 'java-17'
  }

  environment {
    APP_NAME = "boardgame"
    VERSION  = "1.0.${BUILD_NUMBER}"

    // Nexus
    NEXUS_URL = "http://localhost:8081"
  }

  stages {

    /* ===================== CODE ===================== */

    stage('Checkout Code') {
      steps {
        git branch: 'main',
            url: 'https://github.com/devopsghazali/devsecops_ci_cd_project.git'
      }
    }

    stage('Gitleaks Scan') {
      steps {
        sh 'gitleaks detect --source . --exit-code 1'
      }
    }

    /* ===================== BUILD ===================== */

    stage('Maven Compile') {
      steps {
        sh 'mvn clean compile'
      }
    }

    stage('SonarQube Analysis') {
      environment {
        SONAR_TOKEN = credentials('sonar-token')
      }
      steps {
        withSonarQubeEnv('sonarqube') {
          sh '''
            mvn sonar:sonar \
            -Dsonar.login=$SONAR_TOKEN
          '''
        }
      }
    }

    stage('Maven Package') {
      steps {
        sh 'mvn package -DskipTests'
      }
    }

    /* ===================== NEXUS ===================== */

    stage('Publish JAR to Nexus') {
      steps {
        withCredentials([usernamePassword(
          credentialsId: 'nexus-cred',
          usernameVariable: 'NEXUS_USER',
          passwordVariable: 'NEXUS_PASS'
        )]) {
          sh '''
            mvn deploy \
            -Dnexus.username=$NEXUS_USER \
            -Dnexus.password=$NEXUS_PASS
          '''
        }
      }
    }

    /* ===================== DOCKER ===================== */

    stage('Docker Build') {
      steps {
        sh '''
          docker build \
          -t ${APP_NAME}:${VERSION} .
        '''
      }
    }

    /* ===================== KUBERNETES (kind) ===================== */

    stage('Deploy to Kubernetes (kind)') {
      steps {
        sh '''
          echo "Deploying to kind cluster..."

          sed -i "s|TAG|${VERSION}|g" deployment-service.yaml

          kubectl apply -f deployment-service.yaml
        '''
      }
    }

    stage('Verify Kubernetes Deployment') {
      steps {
        sh '''
          echo "Waiting for rollout..."
          kubectl rollout status deployment/boardgame --timeout=90s

          echo "Pods:"
          kubectl get pods -l app=boardgame

          echo "Services:"
          kubectl get svc
        '''
      }
    }

    /* ===================== MONITORING ===================== */

    stage('Install Prometheus + Grafana (Helm)') {
      steps {
        sh '''
          helm repo add prometheus-community https://prometheus-community.github.io/helm-charts || true
          helm repo update

          helm upgrade --install monitoring prometheus-community/kube-prometheus-stack \
            --namespace monitoring --create-namespace
        '''
      }
    }

  }

  post {
    success {
      echo "✅ CI/CD + Kubernetes + Monitoring setup successful"
    }
    failure {
      echo "❌ Pipeline failed — check stage logs"
    }
  }
}
